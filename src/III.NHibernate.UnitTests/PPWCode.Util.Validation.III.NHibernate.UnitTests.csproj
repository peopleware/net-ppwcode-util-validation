<Project Sdk="Microsoft.NET.Sdk">
  
  <Import Project="..\common-tests.props" />

  <PropertyGroup>
    <!-- Target frameworks -->
    <TargetFrameworks>net8.0;net9.0;net10.0;net462;net47;net471;net472;net48;net481</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OS)' != 'Windows_NT' And $(ContinuousIntegrationBuild) == 'true' ">
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PPWCode.Vernacular.NHibernate.III.Test" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\III.NHibernate\PPWCode.Util.Validation.III.NHibernate.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <None Remove="hibernate.cfg.xml"/>
    <Content Include="hibernate.cfg.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Remove="log4net.config"/>
    <Content Include="log4net.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Remove="appsettings.json"/>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
